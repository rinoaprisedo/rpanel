# Managed by the RPanel installer. Public entry point of the panel:
#   - TLS on @PANEL_PORT@; the host name and certificate live in ssl/panel-tls.conf and the
#     catch-all that drops requests for any other host (e.g. the bare IP) in ssl/panel-guard.conf.
#     Both are owned by the panel (Settings > Panel SSL) and are never overwritten by updates.
#   - "secret entrance": every request without the entrance cookie gets a 404;
#     visiting https://<host>:@PANEL_PORT@@ENTRANCE@ sets the cookie and redirects to /login
#   - /api and /uploads proxied to the local backend, the SPA served as static files
map $http_upgrade $rpanel_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen @PANEL_PORT@ ssl;
    listen [::]:@PANEL_PORT@ ssl;
    include @INSTALL_DIR@/ssl/panel-tls.conf;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:RPANELSSL:5m;

    client_max_body_size 4g;
    server_tokens off;

    # Plain HTTP sent to the HTTPS port: send the browser to https://.
    error_page 497 =301 https://$host:$server_port$request_uri;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = @ENTRANCE@ {
        add_header Set-Cookie "rp_entrance=@TOKEN@; Path=/; Max-Age=31536000; HttpOnly; Secure; SameSite=Strict" always;
        return 302 /login;
    }

    location /api/ {
        if ($cookie_rp_entrance != "@TOKEN@") { return 404; }
        proxy_pass http://127.0.0.1:@BACKEND_PORT@;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite (never append to) the client-supplied header: the backend only trusts this proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $rpanel_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location /uploads/ {
        if ($cookie_rp_entrance != "@TOKEN@") { return 404; }
        proxy_pass http://127.0.0.1:@BACKEND_PORT@;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        if ($cookie_rp_entrance != "@TOKEN@") { return 404; }
        root @INSTALL_DIR@/web;
        try_files $uri /index.html;
    }
}

include @INSTALL_DIR@/ssl/panel-guard.conf;
