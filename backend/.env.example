APP_ENV=development
APP_PORT=8500
APP_HOST=
FRONTEND_URL=http://localhost:8501,http://localhost:8502

DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=password
DB_NAME=baseadmin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

SESSION_MAX_AGE=86400
SESSION_MAX_CONCURRENT=3

STORAGE_PATH=./storage/uploads
STORAGE_MAX_SIZE=2097152

LOG_CLEANUP_DAYS=90
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_API=100

# File manager: directories non-superadmin users may access (superadmin: whole filesystem)
FM_ROOTS=/www,/home

# Web terminal
TERMINAL_SHELL=/bin/bash
TERMINAL_IDLE_MINUTES=15
TERMINAL_MAX_SESSIONS=3

# Website manager (Nginx / Let's Encrypt)
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_LOG_DIR=/var/log/nginx
WEB_ROOT=/www/wwwroot
ACME_ROOT=/var/www/letsencrypt
CERTBOT_EMAIL=

# Database manager: key used to encrypt stored DB admin passwords (AES-256-GCM).
# Generate with: openssl rand -hex 32   — losing it makes stored credentials unreadable.
DB_SECRET_KEY=
BACKUP_DIR=/www/backup/database

# Docker manager: compose projects live in <COMPOSE_DIR>/<project>/docker-compose.yml
COMPOSE_DIR=/www/docker

# Cron manager
CRON_DIR=/etc/cron.d
CRON_DATA_DIR=/www/cron

# Firewall manager: ports that can never be blocked/removed without explicit confirmation (SSH ports from sshd_config and APP_PORT are always protected)
FIREWALL_PROTECTED_PORTS=
SSHD_CONFIG=/etc/ssh/sshd_config

# Network hardening
# Only these proxies may set X-Forwarded-For (the local nginx). Never put 0.0.0.0/0 here.
TRUSTED_PROXIES=127.0.0.1,::1
# Optional allow-list of IPs/CIDRs; empty = anyone who can reach the panel port
PANEL_ALLOWED_IPS=
# Encrypts DB admin passwords and 2FA secrets (AES-256-GCM): openssl rand -hex 32
SECRET_KEY=
